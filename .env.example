# Optional: copy this file to .env. Defaults work without changing anything.
SITE_ORIGIN=http://127.0.0.1:8000
HOST=127.0.0.1
PORT=8000
DATA_DIR=data
SECURE_COOKIES=0
# On a real HTTPS deployment use the exact public origin and SECURE_COOKIES=1.
# Never expose the local starter directly as a production server.
